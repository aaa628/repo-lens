# Which LLM provider runs Stage 3 (architecture synthesis): "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Anthropic (default provider)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (defaults to medium: good quality/latency balance for this task)
ANTHROPIC_EFFORT=medium

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional but strongly recommended: raises GitHub API limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=
